# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=admin_test_db
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# AWS S3 Configuration
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your_s3_bucket_name

# Mail Configuration
SPRING_MAIL_HOST=your_mail_host_here
SPRING_MAIL_PORT=your_mail_port_here
SPRING_MAIL_USERNAME=your_mail_username_here
SPRING_MAIL_PASSWORD=your_mail_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_VALIDITY_MINUTES=your_jwt_access_validity_minutes_here
JWT_REFRESH_VALIDITY_DAYS=your_jwt_refresh_validity_days_here

# Seed Admin Configuration
ADMIN_SEED_NAME=your_admin_name_here
ADMIN_SEED_EMAIL=your_admin_email_here
ADMIN_SEED_PASSWORD=your_admin_password_here

# Internal API key for service-to-service calls to the inventory service
INTERNAL_API_KEY=your_internal_api_key_here